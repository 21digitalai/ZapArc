{
  "name": "zaparc-wallet-extension",
  "version": "1.0.5",
  "description": "Self-custodial Bitcoin wallet extension with Lightning and on-chain support.",
  "main": "dist/background.js",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "clean": "rimraf dist",
