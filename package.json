    "@vitest/ui": "^4.0.16",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.4.4",
    "typescript": "^5.2.2",
    "vitest": "^4.0.16",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@breeztech/breez-sdk-spark": "0.23.1",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
